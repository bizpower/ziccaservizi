# ---------------------------------------------------------------
# Supabase (progetto proprietario Zicca Servizi)
# Copiare in `.env` e compilare con i valori del proprio progetto.
# Dashboard Supabase -> Project Settings -> API
# ---------------------------------------------------------------

# Usate a runtime lato server (SSR / server functions)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon-public-key>"
SUPABASE_PROJECT_ID="<project-ref>"

# SOLO server: chiave service role, bypassa le RLS. Non esporre mai al client.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Iniettate nel bundle client da Vite (devono avere prefisso VITE_)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-public-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
